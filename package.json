{
  "name": "bloggers-service",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Рабочий сервис по таблице блогеров: поиск, фильтры, воронка статусов, карточки размещений.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && SINGLEFILE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/build-data.mjs",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run coverage && npm run build",
    "coverage": "vitest run --coverage",
    "lint:css": "stylelint \"src/**/*.css\"",
    "size": "node scripts/check-size.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "sbom": "node scripts/write-sbom.mjs",
    "licenses:write": "node scripts/write-licenses.mjs",
    "prepare": "husky || true",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "browserslist": "^4.29.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,html,yml}": [
      "prettier --write"
    ]
  }
}
